# Modelo(s) .gguf: binarios grandes (varios GB) que el usuario descarga por
# separado; ver models/README.txt para donde conseguirlos.
models/*.gguf

# Datos de NLTK descargados en tiempo de ejecucion (stopwords/wordnet).
nltk_data/

# Copia de autoguardado (recuperacion ante cierres/crashes durante una
# generacion larga); no es el proyecto guardado explicitamente por el usuario.
autosave/

# Proyectos del modo servidor (StoryForge en el celular) en desarrollo:
# user_data_dir()/proyectos, que sin empaquetar es la carpeta del repo.
proyectos/

# Empaquetado con PyInstaller. dist/ y build/ son carpetas de trabajo de
# PyInstaller (se regeneran en cada build); StoryForge-App/ es una copia
# limpia de dist/StoryForge/, en una ubicacion fija y facil de encontrar
# (ver build.bat) -- tambien es salida de build, no se versiona.
build/
dist/
StoryForge-App/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# Entornos virtuales
.venv/
.build-venv/
venv/
env/

# Notas sueltas de sesiones de Claude que terminaron en esta carpeta por
# error: dos de estas son literalmente sobre otros proyectos (el editor de
# fotos y el editor de video), no sobre StoryForge; la tercera es una copia
# de una respuesta de chat, redundante con docs/. No se borran (podrian ser
# de interes para el usuario), solo se excluyen de este repo.
photoeditor_instructions.txt
storyforge_instructions.txt
videoeditor_instructor.txt

# Cobertura (scripts/run_coverage.ps1, build.bat)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Ajustes locales del editor
.vscode/
